<?xml version='1.0' encoding='utf-8'?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"TRAINER CONTROLS — opt-in, defaults/presets; Alt activates aim and shooting"</Description>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>2</ID>
          <Description>"Player"</Description>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>3</ID>
              <Description>"Trainer | Health lock [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: health
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('health',100)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('health') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>4</ID>
              <Description>"Trainer | Armour lock [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: armour
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('armour',100)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('armour') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>5</ID>
              <Description>"Trainer | Magazine lock [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: magazines
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('magazines',50)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('magazines') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>6</ID>
              <Description>"Trainer | Reserve ammo [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: reserves
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('reserves',120)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('reserves') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>7</ID>
              <Description>"Trainer | Grenade supply [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: grenades
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('grenades',5)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('grenades') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>32</ID>
              <Description>"Trainer | Keep akimbo available [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: akimbo
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('akimbo',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('akimbo') end
{$asm}
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>8</ID>
          <Description>"Weapons"</Description>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>9</ID>
              <Description>"Trainer | No recoil &amp; kick"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: no_recoil
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('no_recoil',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('no_recoil') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>10</ID>
              <Description>"Trainer | Minimum spread"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: no_spread
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('no_spread',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('no_spread') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>11</ID>
              <Description>"Trainer | Attack interval [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: rapid_fire
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('rapid_fire',25)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('rapid_fire') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>12</ID>
              <Description>"Trainer | Fast reload [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: fast_reload
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('fast_reload',50)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('fast_reload') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>13</ID>
              <Description>"Trainer | Hold-to-fire conversion"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: automatic
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('automatic',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('automatic') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>14</ID>
              <Description>"Trainer | Magazine capacity [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: large_mags
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('large_mags',100)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('large_mags') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>15</ID>
              <Description>"Trainer | Shared weapon damage [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: damage
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('damage',200)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('damage') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>16</ID>
              <Description>"Trainer | Through-wall shots (experimental) [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: wall_shots
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('wall_shots',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('wall_shots') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>22</ID>
              <Description>"Trainer | Clear firing cooldown [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: no_cooldown
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('no_cooldown',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('no_cooldown') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>33</ID>
              <Description>"Trainer | Reserve-fed refill [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: auto_refill
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('auto_refill',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('auto_refill') end
{$asm}
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>17</ID>
          <Description>"Camera &amp; movement"</Description>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>18</ID>
              <Description>"Trainer | Field of view"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: fov
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('fov',105)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('fov') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>19</ID>
              <Description>"Trainer | Scope field of view"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: scope_fov
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('scope_fov',35)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('scope_fov') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>20</ID>
              <Description>"Trainer | Gentler falling [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: slow_fall
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('slow_fall',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('slow_fall') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>21</ID>
              <Description>"Trainer | Lock view angles"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: view_lock
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('view_lock',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('view_lock') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>23</ID>
              <Description>"Trainer | Stable camera"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: stable_camera
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('stable_camera',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('stable_camera') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>34</ID>
              <Description>"Trainer | Instant scope settling"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: scope_settle
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('scope_settle',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('scope_settle') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>35</ID>
              <Description>"Trainer | Keep sniper scoped"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: scope_lock
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('scope_lock',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('scope_lock') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>36</ID>
              <Description>"Trainer | Bunny hop"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: bunnyhop
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('bunnyhop',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('bunnyhop') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>37</ID>
              <Description>"Trainer | Crouch hold"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: crouch_hold
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('crouch_hold',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('crouch_hold') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>40</ID>
              <Description>"Trainer | Noclip / combat flight [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: noclip
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('noclip',16)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('noclip') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>41</ID>
              <Description>"Trainer | Hover at current height [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: hover
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('hover',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('hover') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>53</ID>
              <Description>"Trainer | Practice movement multiplier [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: speed_hack
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('speed_hack',2)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('speed_hack') end
{$asm}
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>24</ID>
          <Description>"Aim &amp; firing"</Description>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>25</ID>
              <Description>"Trainer | Auto aim — players"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: auto_aim
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('auto_aim',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('auto_aim') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>26</ID>
              <Description>"Trainer | Head aim + auto shoot"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: headshot
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('headshot',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('headshot') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>27</ID>
              <Description>"Trainer | Auto shoot"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: auto_shoot
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('auto_shoot',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('auto_shoot') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>28</ID>
              <Description>"Trainer | Crosshair trigger"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: triggerbot
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('triggerbot',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('triggerbot') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>38</ID>
              <Description>"Trainer | Keep current target"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: target_lock
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('target_lock',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('target_lock') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>39</ID>
              <Description>"Trainer | Nearest-target priority"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: nearest_target
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('nearest_target',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('nearest_target') end
{$asm}
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>29</ID>
          <Description>"Bot practice"</Description>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>30</ID>
              <Description>"Trainer | Stationary bots [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: freeze_bots
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('freeze_bots',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('freeze_bots') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>31</ID>
              <Description>"Trainer | Low-health bots [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: fragile_bots
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('fragile_bots',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('fragile_bots') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>49</ID>
              <Description>"Trainer | Practice bot health [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: bot_health
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('bot_health',100)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('bot_health') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>50</ID>
              <Description>"Trainer | Practice bot armour [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: bot_armour
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('bot_armour',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('bot_armour') end
{$asm}
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>42</ID>
          <Description>"Visibility"</Description>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>43</ID>
              <Description>"Trainer | Through-wall player ESP"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: wall_esp
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('wall_esp',250)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('wall_esp') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>44</ID>
              <Description>"Trainer | Animated model wall view (experimental) [offline only]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: model_wallhack
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('model_wallhack',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('model_wallhack') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>45</ID>
              <Description>"Trainer | Through-wall radar"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: radar
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('radar',75)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('radar') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>46</ID>
              <Description>"Trainer | Include teammates"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: esp_allies
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('esp_allies',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('esp_allies') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>47</ID>
              <Description>"Trainer | ESP tracer lines"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: esp_tracers
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('esp_tracers',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('esp_tracers') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>48</ID>
              <Description>"Trainer | Center crosshair"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: crosshair
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('crosshair',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('crosshair') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>51</ID>
              <Description>"Trainer | Aim cone guide"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: aim_circle
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('aim_circle',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('aim_circle') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>52</ID>
              <Description>"Trainer | Off-screen player bearings"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: offscreen_arrows
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('offscreen_arrows',0)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('offscreen_arrows') end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>54</ID>
              <Description>"Trainer | Visual ping label"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab feature: visual_ping
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

RangeLabCE.enable('visual_ping',50)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.disable('visual_ping') end
{$asm}
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>55</ID>
          <Description>"Trainer | Reset all (uncheck to rearm)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if RangeLabCE then RangeLabCE.stopAll() end
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
{$asm}</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>56</ID>
          <Description>"Trainer | Visual preferences (edit preset; uncheck to reapply)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- RangeLab CE runtime. Embedded into each opt-in feature, never a table startup script.
if _G.RangeLabCE and _G.RangeLabCE.version~=10 and _G.RangeLabCE.stopAll then _G.RangeLabCE.stopAll() end
if not _G.RangeLabCE or _G.RangeLabCE.version ~= 10 then
  local R={version=10,enabled={},saved={},options={cone=35,smoothing=4,range=250,tolerance=0.6,team=true,activation='alt'}}
  _G.RangeLabCE=R
  R.labels={["health"]="Trainer | Health lock [offline only]",["armour"]="Trainer | Armour lock [offline only]",["magazines"]="Trainer | Magazine lock [offline only]",["reserves"]="Trainer | Reserve ammo [offline only]",["grenades"]="Trainer | Grenade supply [offline only]",["no_recoil"]="Trainer | No recoil &amp; kick",["no_spread"]="Trainer | Minimum spread",["rapid_fire"]="Trainer | Attack interval [offline only]",["fast_reload"]="Trainer | Fast reload [offline only]",["automatic"]="Trainer | Hold-to-fire conversion",["large_mags"]="Trainer | Magazine capacity [offline only]",["damage"]="Trainer | Shared weapon damage [offline only]",["wall_shots"]="Trainer | Through-wall shots (experimental) [offline only]",["fov"]="Trainer | Field of view",["scope_fov"]="Trainer | Scope field of view",["slow_fall"]="Trainer | Gentler falling [offline only]",["view_lock"]="Trainer | Lock view angles",["no_cooldown"]="Trainer | Clear firing cooldown [offline only]",["stable_camera"]="Trainer | Stable camera",["auto_aim"]="Trainer | Auto aim — players",["headshot"]="Trainer | Head aim + auto shoot",["auto_shoot"]="Trainer | Auto shoot",["triggerbot"]="Trainer | Crosshair trigger",["freeze_bots"]="Trainer | Stationary bots [offline only]",["fragile_bots"]="Trainer | Low-health bots [offline only]",["akimbo"]="Trainer | Keep akimbo available [offline only]",["auto_refill"]="Trainer | Reserve-fed refill [offline only]",["scope_settle"]="Trainer | Instant scope settling",["scope_lock"]="Trainer | Keep sniper scoped",["bunnyhop"]="Trainer | Bunny hop",["crouch_hold"]="Trainer | Crouch hold",["target_lock"]="Trainer | Keep current target",["nearest_target"]="Trainer | Nearest-target priority",["noclip"]="Trainer | Noclip / combat flight [offline only]",["hover"]="Trainer | Hover at current height [offline only]",["wall_esp"]="Trainer | Through-wall player ESP",["model_wallhack"]="Trainer | Animated model wall view (experimental) [offline only]",["radar"]="Trainer | Through-wall radar",["esp_allies"]="Trainer | Include teammates",["esp_tracers"]="Trainer | ESP tracer lines",["crosshair"]="Trainer | Center crosshair",["bot_health"]="Trainer | Practice bot health [offline only]",["bot_armour"]="Trainer | Practice bot armour [offline only]",["aim_circle"]="Trainer | Aim cone guide",["offscreen_arrows"]="Trainer | Off-screen player bearings",["speed_hack"]="Trainer | Practice movement multiplier [offline only]",["visual_ping"]="Trainer | Visual ping label"}
  R.bounds={["speed_hack"]={1,5},["visual_ping"]={0,999},["noclip"]={1,50},["bot_health"]={1,1000},["bot_armour"]={0,1000},["wall_esp"]={10,500},["radar"]={10,250},["health"]={1,1000},["armour"]={0,1000},["magazines"]={1,999},["reserves"]={0,9999},["grenades"]={0,50},["rapid_fire"]={1,250},["fast_reload"]={1,1000},["large_mags"]={1,999},["damage"]={1,2000},["fov"]={75,120},["scope_fov"]={5,60}}
  R.offline={["model_wallhack"]="Experimental native rendering is currently supported in offline practice only.",["wall_shots"]="Through-wall hit registration has only been implemented for local practice, not verified on remote servers.",["speed_hack"]="Movement multipliers need a locally controlled simulation.",["health"]="Health is owned by the server.",["armour"]="Armour is owned by the server.",["magazines"]="The server tracks magazine ammunition; local locks cause rejected shots.",["reserves"]="The server tracks reserve ammunition.",["grenades"]="The server tracks grenade inventory.",["rapid_fire"]="The server enforces its own attack interval.",["fast_reload"]="The server enforces reload timing and ammunition transfer.",["large_mags"]="The server uses its own magazine sizes.",["damage"]="The server computes weapon damage.",["no_cooldown"]="Clearing local cooldown does not clear server cooldown.",["auto_refill"]="A local refill does not reload the server magazine.",["akimbo"]="The server validates the akimbo power-up and its expiry.",["slow_fall"]="The server can correct altered movement.",["noclip"]="Flight needs support from a server you control.",["hover"]="Hover needs support from a server you control.",["freeze_bots"]="Bot simulation edits require a local bot match.",["fragile_bots"]="Bot health edits require a local bot match.",["bot_health"]="Bot health edits require a local bot match.",["bot_armour"]="Bot armour edits require a local bot match."}
  R.stock={{[70]=0,[72]=500,[74]=50,[86]=1},{[70]=1400,[72]=160,[74]=18,[86]=10},{[70]=1800,[72]=720,[74]=60,[86]=10},{[70]=2400,[72]=880,[74]=1,[86]=7},{[70]=1650,[72]=80,[74]=16,[86]=30},{[70]=1950,[72]=1500,[74]=82,[86]=5},{[70]=2000,[72]=120,[74]=22,[86]=20},{[70]=1000,[72]=650,[74]=200,[86]=1},{[70]=1400,[72]=80,[74]=18,[86]=20}}
  -- Native patches run only when explicitly enabled, and only offline.
  R.native={};R.nativeAllocations={}
  local function u32(v)return string.pack('&lt;I4',v%0x100000000)end
  local function rel(op,a,b)return string.char(op)..u32(b-a-5)end
  local function hexbytes(s)return (s:gsub('.',function(c)return string.format('%02X ',c:byte())end))end
  local function bytes(a,n)
    local t=assert(readBytes(a,n,true),'Native code read failed')
    return string.char(table.unpack(t))
  end
  local function nativeWrite(a,s)
    assert(autoAssemble(string.format('%X:\ndb %s',a,hexbytes(s))),'Native patch write failed')
    assert(bytes(a,#s)==s,'Native patch verification failed')
  end
  local function paused(fn)
    pause()
    local ok,err=pcall(fn)
    unpause()
    if not ok then error(err)end
  end
  function R.nativePlan(name,cave)
    local b=R.base
    if name=='model_wallhack'then
      local push=assert(getAddressSafe('opengl32.glPushAttrib'),'Open a rendered game level first')
      local pop=assert(getAddressSafe('opengl32.glPopAttrib'),'OpenGL export unavailable')
      local code='\x9c\x60\x68'..u32(0x2100)..'\xb8'..u32(push)..'\xff\xd0'
      code=code..'\x68'..u32(0xB71)..'\xff\x15'..u32(b+0x125290)..'\x6a\x00\xff\x15'..u32(b+0x125240)..'\x61\x9d'
      code=code..rel(0xE8,cave+#code,b+0x67FA0)..'\x9c\x60\xb8'..u32(pop)..'\xff\xd0\x61\x9d\xc3'
      code=code..string.rep('\x90',0x100-#code)..string.pack('&lt;f',-1)
      return code,{{b+0x62C79,'\xf3\x0f\x10\x1d'..u32(b+0x15BC88),'\xf3\x0f\x10\x1d'..u32(cave+0x100)},
                   {b+0x56C7E,rel(0xE8,b+0x56C7E,b+0x67FA0),rel(0xE8,b+0x56C7E,cave)}}
    end
    assert(name=='wall_shots','Unknown native control')
    return string.pack('&lt;f',1),{{b+0x56BA2,'\xf3\x0f\x10\x2d'..u32(b+0x16BA98),'\xf3\x0f\x10\x2d'..u32(cave)},
                              {b+0x56C5E,rel(0xE8,b+0x56C5E,b+0xCCA80),string.rep('\x90',5)}}
  end
  function R.nativeEnable(name)
    assert(not R.online(),'Native controls currently support offline practice only')
    assert(not R.native[name],'Native patch already active')
    local cave=R.nativeAllocations[name]
    if not cave then cave=assert(allocateMemory(4096,nil,0x40),'Native allocation failed');R.nativeAllocations[name]=cave end
    local code,patches=R.nativePlan(name,cave)
    paused(function()
      for _,p in ipairs(patches)do assert(bytes(p[1],#p[2])==p[2],'Native code mismatch; restart the game and close other trainers')end
      nativeWrite(cave,code)
      local applied={}
      local ok,err=pcall(function()
        for _,p in ipairs(patches)do applied[#applied+1]=p;nativeWrite(p[1],p[3])end
      end)
      R.native[name]=applied
      if not ok then
        for i=#applied,1,-1 do nativeWrite(applied[i][1],applied[i][2])end
        R.native[name]=nil;error(err)
      end
    end)
  end
  function R.nativeDisable(name)
    local patches=R.native[name];if not patches then return end
    paused(function()
      for _,p in ipairs(patches)do local s=bytes(p[1],#p[2]);assert(s==p[2]or s==p[3],'Another tool changed the native patch; restart game to recover')end
      for i=#patches,1,-1 do nativeWrite(patches[i][1],patches[i][2])end
    end)
    R.native[name]=nil
  end
  function R.nativeReset()
    local keys={};for key in pairs(R.native)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.nativeDisable(key)end
  end

  R.visualOptions={["esp_boxes"]=true,["esp_names"]=true,["esp_health"]=true,["esp_armour"]=true,["esp_distance"]=true,["enemy_color"]="#FFAF70",["ally_color"]="#74E2C7",["crosshair_color"]="#74E2C7",["crosshair_style"]="plus",["crosshair_size"]=10,["crosshair_gap"]=4,["crosshair_width"]=2,["esp_line_width"]=2,["esp_text_size"]=9,["radar_size"]=180}
  local visualBounds={["crosshair_size"]={2,40},["crosshair_gap"]={0,20},["crosshair_width"]={1,6},["esp_line_width"]={1,5},["esp_text_size"]={7,20},["radar_size"]={120,320}}
  function R.configureVisuals(values)
    for key,value in pairs(values)do
      local default=R.visualOptions[key];assert(default~=nil,'Unknown visual setting')
      local bounds=visualBounds[key]
      if bounds then assert(type(value)=='number'and value==math.floor(value)and value&gt;=bounds[1]and value&lt;=bounds[2],'Invalid visual size')
      elseif type(default)=='boolean'then assert(type(value)=='boolean','Expected true or false')
      elseif key=='crosshair_style'then assert(value=='plus'or value=='dot'or value=='circle','Unknown crosshair style')
      else assert(type(value)=='string'and value:match('^#%x%x%x%x%x%x$'),'Expected #RRGGBB')end
    end
    for key,value in pairs(values)do R.visualOptions[key]=value end
  end
  local firearms={1,2,3,4,5,6,8}
  local combat={auto_aim=true,headshot=true,auto_shoot=true,triggerbot=true}
  local function rd(a,k)
    local v
    if k=='float' then v=readFloat(a)
    elseif k=='short' then v=readSmallInteger(a,true)
    elseif k=='byte' then local b=readBytes(a,1,true);v=b and b[1]
    else v=readInteger(a,k~='uint') end
    assert(v~=nil,'Unreadable game field');return v
  end
  local function wr(a,k,v)
    local ok
    if k=='float' then ok=writeFloat(a,v)
    elseif k=='short' then ok=writeSmallInteger(a,v)
    elseif k=='byte' then ok=writeBytes(a,v)
    else ok=writeInteger(a,v) end
    assert(ok~=false,'Game write failed')
  end
  local sizes={byte=1,short=2,float=4,int=4,uint=4}
  local function vec(p,off)return {rd(p+off,'float'),rd(p+off+4,'float'),rd(p+off+8,'float')}end
  local function dist(a,b)return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)end
  local function delta(a,b)return (a-b+180)%360-180 end
  local function angles(a,b)
    local x,y,z=b[1]-a[1],b[2]-a[2],b[3]-a[3]
    local flat=math.sqrt(x*x+y*y);if flat&lt;0.000001 then return nil end
    return math.deg(math.atan(x,-y))%360,math.deg(math.atan(z,flat))
  end
  function R.player()
    assert(R.pid==getOpenedProcessID(),'Reattach, then disable/re-enable trainer entries')
    local p=rd(R.base+0x18AC00,'uint')
    assert(p&gt;0x10000 and p&lt;0x7fff0000,'Player is not ready')
    local vt=rd(p,'uint');assert(vt&gt;=R.base and vt&lt;R.base+0x1B9000,'Player layout mismatch')
    local h,g=rd(p+0xEC,'int'),rd(p+0xFC,'int')
    assert(h&gt;=-10000 and h&lt;=10000 and g&gt;=0 and g&lt;9,'Player field mismatch');return p
  end
  function R.guard()
    local pid,base=getOpenedProcessID(),getAddressSafe('ac_client.exe')
    assert(pid~=0 and base,'Attach CE to ac_client.exe first')
    assert(getModuleSize('ac_client.exe')==0x1B9000,'Unsupported module layout')
    local path
    for _,m in ipairs(enumModules())do if m.Name:lower()=='ac_client.exe' then path=m.PathToFile end end
    assert(path and md5file(path):lower()=='2abc290c544e3ba2125c94ca255d07b2','Unsupported executable fingerprint')
    if R.pid and R.pid~=pid then
      R.timer.Enabled=false;R.enabled={};R.saved={};R.native={};R.nativeAllocations={};R.attack=nil;R.jump=nil;R.speed=nil;R.locked=nil;R.entry=nil;R.paused=nil;R.lastOnline=nil;R.hideVisuals()
    end
    R.pid,R.base=pid,base
    local p=R.player()
    assert(readString(base+0x16BCC0,23)=='knife','Weapon table mismatch')
    for i=0,8 do local w=rd(p+0x33C+i*4,'uint');assert(rd(w+8,'uint')==p and rd(w+12,'uint')==base+0x16BCC0+i*104,'Weapon references mismatch')end
    return p
  end
  function R.weapon(p,i)
    local w=rd(p+0x33C+i*4,'uint');assert(w&gt;0x10000 and w&lt;0x7fff0000 and rd(w+4,'int')==i and rd(w+8,'uint')==p,'Weapon object mismatch');return w
  end
  function R.online()
    local connected=rd(R.base+0x18ABC8,'int');assert(connected==0 or connected==1,'Connection state mismatch')
    return connected==1
  end
  function R.enforceMultiplayer()
    local online=R.online()
    if online then
      local remove={};for name in pairs(R.enabled)do if R.offline[name]then remove[#remove+1]=name end end
      for _,name in ipairs(remove)do R.turnOff(name)end
      if not R.lastOnline then
        for i,fields in ipairs(R.stock)do for off,value in pairs(fields)do wr(R.base+0x16BCC0+(i-1)*104+off,'short',value)end end
        print('RangeLab multiplayer: restored stock weapon sizes, damage and timings. Respawn once to resync server health/ammo. Offline-only controls are unavailable.')
      end
    end
    R.lastOnline=online
  end
  function R.teamMode()
    local mode=rd(R.base+0x18ABF8,'int')
    return ({[0]=true,[4]=true,[5]=true,[7]=true,[11]=true,[13]=true,[14]=true,[16]=true,[17]=true,[20]=true,[21]=true})[mode]or false
  end
  function R.allied(a,b)return R.teamMode()and(a==0 or a==1)and a==b end
  function R.bots(includePlayers)
    local arr,cap,n=rd(R.base+0x18AC04,'uint'),rd(R.base+0x18AC08,'int'),rd(R.base+0x18AC0C,'int')
    assert(n&gt;=0 and n&lt;=cap and cap&lt;=128 and (n==0 or arr&gt;0x10000 and arr&lt;0x7fff0000),'Entity vector mismatch')
    local now=rd(R.base+0x17F10C,'int');local result={}
    for i=0,n-1 do
      local q=rd(arr+i*4,'uint')
      if q~=R.player()and q&gt;0x10000 and q&lt;0x7fff0000 then
        local ok,b=pcall(function()
          local vt=rd(q,'uint');local kind=rd(q+0x77,'byte')
          if vt&lt;R.base or vt&gt;=R.base+0x1B9000 or not(kind==1 or includePlayers and kind==0)then return nil end
          local pos,head=vec(q,4),vec(q,0x3F8)
          for _,v in ipairs(pos)do if v~=v or math.abs(v)&gt;4096 then return nil end end
          local valid=head[1]&gt;=0 and dist(pos,head)&lt;4
          local age=now-rd(q+0xE4,'int')
          return {p=q,type=kind,pos=pos,head=head,valid=valid,rendered=valid and age&gt;=0 and age&lt;=150,health=rd(q+0xEC,'int'),armour=rd(q+0xF0,'int'),state=rd(q+0x76,'byte'),team=rd(q+0x30C,'int'),eye=rd(q+0x50,'float'),name=readString(q+0x205,20)or'Player'}
        end)
        if ok and b then result[#result+1]=b end
      end
    end
    return result
  end
  function R.releaseAttack()
    if R.attack then pcall(function()if R.player()==R.attack then wr(R.attack+0x204,'byte',0)end end)end;R.attack=nil
  end
  function R.releaseJump()
    if R.jump then pcall(function()if R.player()==R.jump then wr(R.jump+0x5F,'byte',0)end end)end;R.jump=nil
  end
  function R.releaseSpeed()
    if R.speed then pcall(function()if R.player()==R.speed then wr(R.speed+0x74,'byte',0);wr(R.speed+0x75,'byte',0)end end)end;R.speed=nil
  end
  function R.savewrite(name,a,k,v,owner,isbot)
    local key=tostring(a)..':'..k;local saved=R.saved[name]
    if not saved[key]then saved[key]={a=a,k=k,bytes=assert(readBytes(a,sizes[k],true)),owner=owner,bot=isbot}end
    wr(a,k,v)
  end
  function R.restore(name)
    local saved=R.saved[name];if not saved or not next(saved)then R.saved[name]=nil;return end
    local p=R.player();local members={}
    for _,b in ipairs(R.bots())do members[b.p]=true end
    local failed=false
    for key,s in pairs(saved)do
      if s.owner and (s.bot and not members[s.owner] or not s.bot and s.owner~=p)then saved[key]=nil
      else local ok=pcall(function()assert(writeBytes(s.a,s.bytes)~=false,'Restore failed')end);if ok then saved[key]=nil else failed=true end end
    end
    if not next(saved)then R.saved[name]=nil end
    assert(not failed,'Restore incomplete; retry disabling the feature')
  end
  function R.equip(p,i)
    local w=R.weapon(p,i);R.releaseAttack();wr(p+0xFC,'int',i)
    for _,off in ipairs({0x364,0x368,0x36C,0x370})do wr(p+off,'uint',w)end
    wr(p+0xF4,'int',i);wr(p+0xF8,'int',i);wr(p+0x310,'int',0)
  end
  function R.disable(name)
    if R.pid==getOpenedProcessID()then R.nativeDisable(name)end
    R.enabled[name]=nil
    if R.pid~=getOpenedProcessID() or readInteger(R.base+0x18AC00)==nil then R.saved[name]=nil
    else
      if name=='noclip'then R.finishNoclip()end
      if name=='akimbo' and not R.online()and rd(R.player()+0xFC,'int')==8 then local p=R.player();R.equip(p,rd(p+0xF4,'int'))end
      R.restore(name)
    end
    if combat[name]or name=='automatic'then R.releaseAttack()end
    if name=='bunnyhop'then R.releaseJump()end
    if name=='speed_hack'then R.releaseSpeed()end
    if name=='target_lock'or name=='auto_aim'or name=='headshot'then R.locked=nil end
    if R.hideVisuals and not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)then R.hideVisuals()end
    if not next(R.enabled)then R.timer.Enabled=false;R.paused=nil end
  end
  function R.turnOff(name)
    if not R.enabled[name]then return end
    if getAddressList then
      local record=getAddressList().getMemoryRecordByDescription(R.labels[name])
      if record and record.Active then record.Active=false;if not R.enabled[name]then return end end
    end
    R.disable(name)
  end
  function R.stopAll()
    if R.pid==getOpenedProcessID()then R.nativeReset()end
    local keys={};for key in pairs(R.enabled)do keys[#keys+1]=key end
    for _,key in ipairs(keys)do R.turnOff(key)end
    for key in pairs(R.saved)do R.restore(key)end
    R.releaseAttack();R.releaseJump();R.releaseSpeed();R.locked=nil;R.timer.Enabled=false
    if R.hideVisuals then R.hideVisuals()end
  end
  function R.finishNoclip()
    local entry=R.entry
    if entry and not R.online()and R.player()==entry.p and rd(entry.p+0x76,'byte')==0 and rd(entry.p+0xEC,'int')&gt;0 then
      R.moveTo(entry.p,entry.pos)
    end
    R.entry=nil
  end
  function R.moveTo(p,pos)
    local eye=rd(p+0x50,'float')
    for i=1,3 do wr(p+i*4,'float',pos[i]);wr(p+0x24+i*4,'float',pos[i]-(i==3 and eye or 0))end
    for _,off in ipairs({0x10,0x14,0x18,0x1C,0x20,0x24,0x78})do wr(p+off,'float',0)end
    for _,off in ipairs({0x74,0x75,0x5F})do wr(p+off,'byte',0)end
  end
  function R.flightTick(p,alive,focus)
    local entry=R.entry;local now=getTickCount()
    local dt=math.max(0,math.min(0.05,(now-entry.time)/1000));entry.time=now
    if not alive then R.turnOff('noclip');return end
    if focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      local f,r,u=key(0x57)-key(0x53),key(0x44)-key(0x41),key(0x20)-key(0x11)
      local yaw,pitch=math.rad(rd(p+0x34,'float')),math.rad(rd(p+0x38,'float'))
      local d={f*math.sin(yaw)*math.cos(pitch)+r*math.cos(yaw),-f*math.cos(yaw)*math.cos(pitch)+r*math.sin(yaw),f*math.sin(pitch)+u}
      local length=math.sqrt(d[1]^2+d[2]^2+d[3]^2)
      if length&gt;0 then
        local speed=R.enabled.noclip*(isKeyPressed(0x10)and 2 or 1);local candidate={};local valid=true
        for i=1,3 do candidate[i]=entry.current[i]+d[i]/length*speed*dt;if candidate[i]~=candidate[i]or math.abs(candidate[i])&gt;4096 then valid=false end end
        if valid then entry.current=candidate end
      end
    end
    R.moveTo(p,entry.current)
  end
  -- External overlay in CE's own process. No render hooks or remote code execution.
  local function api(name,...)
    local a=getAddressSafe('user32.'..name,true)
    assert(a,'Missing local Windows API: '..name)
    return executeCodeLocalEx(a,...)
  end
  function R.hideVisuals()
    if R.visual then R.visual.form.hide();R.visual.scene=nil end
  end
  function R.project(point,s,w,h)
    local y,p,r=math.rad(s.yaw),math.rad(s.pitch),math.rad(s.roll)
    local x,dy,z=point[1]-s.pos[1],point[2]-s.pos[2],point[3]-s.pos[3]
    local right=x*math.cos(y)+dy*math.sin(y)
    local forward=x*math.sin(y)*math.cos(p)-dy*math.cos(y)*math.cos(p)+z*math.sin(p)
    local up=-x*math.sin(y)*math.sin(p)+dy*math.cos(y)*math.sin(p)+z*math.cos(p)
    if forward&lt;=0.1 or s.fov&lt;=1 or s.fov&gt;=179 then return nil end
    right,up=right*math.cos(r)-up*math.sin(r),right*math.sin(r)+up*math.cos(r)
    local f=w/(2*math.tan(math.rad(s.fov)/2))
    return w/2+right*f/forward,h/2-up*f/forward
  end
  function R.drawVisuals()
    local v=R.visual;if not v or not v.scene then return end
    local s,c,w,h=v.scene,v.paint.Canvas,v.paint.Width,v.paint.Height;local prefs=R.visualOptions
    local function hex(value)return tonumber(value:sub(2,3),16)+tonumber(value:sub(4,5),16)*256+tonumber(value:sub(6,7),16)*65536 end
    c.Brush.Color=0x010101;c.fillRect(0,0,w,h)
    local function round(v)return math.floor(v+0.5)end
    local function line(x,y,a,b)c.line(round(x),round(y),round(a),round(b))end
    local function text(x,y,t)c.textOut(round(x),round(y),t)end
    local function ellipse(x,y,a,b)c.ellipse(round(x),round(y),round(a),round(b))end
    c.Font.Color=hex(prefs.ally_color);c.Font.Size=prefs.esp_text_size;c.Pen.Width=prefs.esp_line_width
    local function color(b)return hex(b.allied and prefs.ally_color or prefs.enemy_color)end
    local function outline(x,y,bw,bh)
      line(x,y,x+bw,y);line(x+bw,y,x+bw,y+bh);line(x+bw,y+bh,x,y+bh);line(x,y+bh,x,y)
    end
    if R.enabled.aim_circle then
      local radius=w/(2*math.tan(math.rad(s.fov)/2))*math.tan(math.rad(math.min(80,R.options.cone)))
      c.Pen.Color=0xC7E274
      -- Use short line segments so the circle leaves its interior transparent.
      for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32
        line(w/2+radius*math.cos(a),h/2+radius*math.sin(a),w/2+radius*math.cos(b),h/2+radius*math.sin(b))
      end
    end
    if R.enabled.offscreen_arrows then
      local yaw=math.rad(s.yaw)
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=(R.enabled.wall_esp or 250)then
        local sx,sy=R.project(b.pos,s,w,h)
        if not sx or sx&lt;0 or sx&gt;w or sy&lt;0 or sy&gt;h then
          local x,y=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
          local dx,dy=x*math.cos(yaw)+y*math.sin(yaw),-(x*math.sin(yaw)-y*math.cos(yaw))
          if math.abs(dx)+math.abs(dy)&gt;0.01 and w&gt;64 and h&gt;64 then
            local scale=math.min((w/2-24)/math.max(math.abs(dx),0.0001),(h/2-24)/math.max(math.abs(dy),0.0001))
            local px,py=w/2+dx*scale,h/2+dy*scale;local a=math.atan(dy,dx)
            c.Pen.Color=color(b)
            for _,turn in ipairs({-0.65,0.65})do line(px,py,px-12*math.cos(a+turn),py-12*math.sin(a+turn))end
          end
        end
      end end
    end
    if R.enabled.wall_esp then
      for _,b in ipairs(s.bots)do if dist(s.pos,b.pos)&lt;=R.enabled.wall_esp then
        local tx,ty=R.project({b.pos[1],b.pos[2],b.pos[3]+0.8},s,w,h)
        local bx,by=R.project({b.pos[1],b.pos[2],b.pos[3]-b.eye},s,w,h)
        if tx and bx then
          local bh=math.abs(by-ty);local bw=bh*0.42;local x=(tx+bx)/2-bw/2;local y=math.min(ty,by)
          if bh&gt;=2 and bh&lt;h*4 and x+bw&gt;=0 and x&lt;=w and y+bh&gt;=0 and y&lt;=h then
            c.Pen.Color=color(b);c.Font.Color=color(b)
            if prefs.esp_boxes then outline(x,y,bw,bh)end
            local labels={}
            if prefs.esp_names then labels[#labels+1]=b.name or'Player'end
            if prefs.esp_health then
              labels[#labels+1]=b.health..'HP';c.Pen.Color=hex(prefs.ally_color)
              line(x-4,y+bh,x-4,y+bh*(1-math.max(0,math.min(1,b.health/100))))
            end
            if prefs.esp_armour then
              labels[#labels+1]=b.armour..'AR';c.Pen.Color=0xFFB878
              line(x,y+bh+4,x+bw*math.max(0,math.min(1,b.armour/100)),y+bh+4)
            end
            if prefs.esp_distance then labels[#labels+1]=math.floor(dist(s.pos,b.pos))..'u'end
            text(x,math.max(0,y-16),table.concat(labels,' '))
            if R.enabled.esp_tracers then c.Pen.Color=color(b);line(w/2,h-4,x+bw/2,y+bh)end
          end
        end
      end end
    end
    if R.enabled.radar then
      local size=math.min(prefs.radar_size,w-32,h-32);local left,top=w-size-16,16
      c.Brush.Color=0x20170E;c.fillRect(left,top,left+size,top+size);c.Pen.Color=0xC7E274
      outline(left,top,size,size);line(left+size/2,top+24,left+size/2,top+size-8);line(left+8,top+size/2,left+size-8,top+size/2)
      c.Font.Color=0xC7E274;text(left+8,top+4,'BOT RADAR '..R.enabled.radar..'u')
      local a=math.rad(s.yaw);local scale=(size/2-8)/R.enabled.radar
      for _,b in ipairs(s.bots)do
        local dx,dy=b.pos[1]-s.pos[1],b.pos[2]-s.pos[2]
        if math.sqrt(dx*dx+dy*dy)&lt;=R.enabled.radar then
          local x=left+size/2+(dx*math.cos(a)+dy*math.sin(a))*scale
          local y=top+size/2-(dx*math.sin(a)-dy*math.cos(a))*scale
          c.Brush.Color=color(b);c.Pen.Color=color(b);ellipse(x-3,y-3,x+3,y+3)
        end
      end
      c.Pen.Color=0xC7E274;c.Brush.Color=0xC7E274;ellipse(left+size/2-2,top+size/2-2,left+size/2+2,top+size/2+2)
    end
    if R.enabled.crosshair then
      c.Pen.Color=hex(prefs.crosshair_color);c.Pen.Width=prefs.crosshair_width
      local x,y=w/2,h/2;local size,gap=prefs.crosshair_size,math.min(prefs.crosshair_gap,prefs.crosshair_size-1)
      if prefs.crosshair_style=='plus'then
        line(x-size,y,x-gap,y);line(x+gap,y,x+size,y);line(x,y-size,x,y-gap);line(x,y+gap,x,y+size)
      elseif prefs.crosshair_style=='circle'then
        for i=0,63 do local a,b=i*math.pi/32,(i+1)*math.pi/32;line(x+size*math.cos(a),y+size*math.sin(a),x+size*math.cos(b),y+size*math.sin(b))end
      else c.Brush.Color=hex(prefs.crosshair_color);ellipse(x-size/4,y-size/4,x+size/4,y+size/4)end
    end
    if R.enabled.visual_ping then c.Font.Color=hex(prefs.ally_color);text(16,16,'PING DISPLAY: '..R.enabled.visual_ping..' ms (visual only)')end
  end
  function R.updateVisuals(p,focus,bots)
    if not(R.enabled.wall_esp or R.enabled.radar or R.enabled.crosshair or R.enabled.aim_circle or R.enabled.offscreen_arrows or R.enabled.visual_ping)or not focus then R.hideVisuals();return end
    if not R.visual then
      local form=createForm(false);form.Caption='RangeLab CE practice overlay';form.BorderStyle='bsNone';form.Color=0x010101
      form.DoNotSaveInTable=true;form.setLayeredAttributes(0x010101,255,1)
      local paint=createPaintBox(form);paint.Align='alClient';paint.OnPaint=R.drawVisuals
      local stream=createMemoryStream();stream.Size=24
      R.visual={form=form,paint=paint,stream=stream}
      -- WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, in CE's local process only.
      local style=api('GetWindowLongA',form.Handle,-20)
      api('SetWindowLongA',form.Handle,-20,style | 0x20 | 0x08000000)
    end
    local v=R.visual;local hwnd=api('GetForegroundWindow')
    assert(getWindowProcessID(hwnd)==R.pid,'Game window changed')
    local mem=v.stream.Memory
    if api('GetClientRect',hwnd,mem)==0 then R.hideVisuals();return end
    writeIntegerLocal(mem+16,0);writeIntegerLocal(mem+20,0)
    if api('ClientToScreen',hwnd,mem+16)==0 then R.hideVisuals();return end
    local w,h=readIntegerLocal(mem+8),readIntegerLocal(mem+12)
    if w&lt;=0 or h&lt;=0 then R.hideVisuals();return end
    if not v.form.Visible then
      v.form.show()
      -- Keep LCL's visibility state in sync; undo focus only if show activated this form.
      if api('GetForegroundWindow')==v.form.Handle then api('SetForegroundWindow',hwnd)end
    end
    -- Actual HWND placement uses physical client coordinates and never takes focus.
    api('SetWindowPos',v.form.Handle,-1,readIntegerLocal(mem+16),readIntegerLocal(mem+20),w,h,0x0010|0x0040)
    local s={pos=vec(p,4),yaw=rd(p+0x34,'float'),pitch=rd(p+0x38,'float'),roll=rd(p+0x3C,'float'),fov=rd(R.base+0x18A7CC,'float'),team=rd(p+0x30C,'int'),bots={}}
    if rd(p+0xFC,'int')==5 and rd(R.weapon(p,5)+0x28,'byte')~=0 then s.fov=rd(R.base+0x18A834,'int')end
    for _,b in ipairs(R.bots(true))do
      b.allied=R.allied(s.team,b.team)
      if b.state==0 and b.health&gt;0 and(b.team==0 or b.team==1)and(R.enabled.esp_allies or not b.allied)then s.bots[#s.bots+1]=b end
    end
    v.scene=s;v.paint.repaint()
  end

  function R.edits(name,value,p)
    if name=='model_wallhack'or name=='wall_shots'then return {}end
    local result={};local function put(a,k,v,owner)result[#result+1]={a,k,v,owner}end
    local function pl(off,k,v)put(p+off,k,v,p)end
    if name=='health'then pl(0xEC,'int',value)
    elseif name=='armour'then pl(0xF0,'int',value)
    elseif name=='magazines'or name=='reserves'then for _,i in ipairs(firearms)do pl((name=='magazines'and 0x128 or 0x104)+i*4,'int',value)end
    elseif name=='grenades'then pl(0x144,'int',value)
    elseif name=='slow_fall'then pl(0x48,'int',0)
    elseif name=='hover'then pl(12,'float',value);pl(0x30,'float',value-rd(p+0x50,'float'));pl(0x18,'float',0);pl(0x24,'float',0);pl(0x48,'int',0)
    elseif name=='view_lock'then pl(0x34,'float',value[1]);pl(0x38,'float',value[2])
    elseif name=='fov'then put(R.base+0x18A7CC,'float',value)
    elseif name=='scope_fov'then put(R.base+0x18A834,'int',value)
    elseif name=='crouch_hold'then pl(0x63,'byte',1)
    elseif name=='stable_camera'then for _,off in ipairs({0x3C,0x40,0x32C,0x330})do pl(off,'float',0)end
    elseif name=='no_cooldown'then local i=rd(p+0xFC,'int');if i~=0 and i~=7 then pl(0x14C+i*4,'int',0)end
    elseif name=='akimbo'then pl(0x100,'byte',1);put(R.weapon(p,8)+0x2C,'int',rd(R.base+0x17F10C,'int')+30000,p)
    elseif name=='scope_lock'or name=='scope_settle'then
      if rd(p+0xFC,'int')==5 then local w=R.weapon(p,5)
        if name=='scope_lock'then put(w+0x28,'byte',1,p);pl(0x66,'byte',1)
        else put(w+0x2C,'int',rd(R.base+0x17F10C,'int')-181,p)end
      end
    else
      local fields={no_recoil={{0x54,0},{0x58,0},{0x5A,0},{0x5E,0},{0x60,0}},no_spread={{0x52,0}},rapid_fire={{0x48,value}},fast_reload={{0x46,value}},automatic={{0x66,1}},large_mags={{0x56,value}},damage={{0x4A,value}}}
      if fields[name]then for _,i in ipairs(firearms)do if name~='damage'or i~=3 then
        for _,field in ipairs(fields[name])do put(R.base+0x16BCC0+i*104+field[1],name=='automatic'and'byte'or'short',field[2])end
      end end end
    end
    return result
  end
  function R.target(bots,src,yaw,pitch,team,head)
    local best,score
    for _,b in ipairs(bots)do
      if b.state==0 and b.health&gt;0 and (not R.options.team or not R.allied(team,b.team))and b.rendered and(not head or b.valid)then
        local point=head and b.head or {b.pos[1],b.pos[2],b.pos[3]-b.eye*0.45}
        local d=dist(src,point);local y,t=angles(src,point)
        if y and d&gt;=0.5 and d&lt;=R.options.range then
          local err=math.sqrt(delta(y,yaw)^2+(t-pitch)^2)
          if err&lt;=R.options.cone then
            local rank=R.enabled.nearest_target and d or err
            if R.enabled.target_lock and R.locked==b.p then rank=-1 end
            if not score or rank&lt;score then best={p=b.p,yaw=y,pitch=t,error=err};score=rank end
          end
        end
      end
    end
    return best
  end
  function R.tick()
    R.enforceMultiplayer()
    local p=R.player()
    if R.entry and R.entry.p~=p then R.turnOff('noclip')end
    local state=rd(p+0x76,'byte')
    local alive=state==0 and rd(p+0xEC,'int')&gt;0
    local bots
    for name,value in pairs(R.enabled)do
      for _,edit in ipairs(R.edits(name,value,p))do
        if not edit[4]or alive then R.savewrite(name,edit[1],edit[2],edit[3],edit[4])end
      end
    end
    if R.enabled.freeze_bots or R.enabled.fragile_bots or R.enabled.bot_health or R.enabled.bot_armour then
      bots=R.bots();local team=rd(p+0x30C,'int')
      for _,b in ipairs(bots)do if b.state==0 and b.health&gt;0 and(not R.options.team or not R.allied(team,b.team))then
        if R.enabled.freeze_bots then R.savewrite('freeze_bots',b.p+0x44,'float',0,b.p,true)end
        if R.enabled.fragile_bots then R.savewrite('fragile_bots',b.p+0xEC,'int',1,b.p,true)end
        if R.enabled.bot_health then R.savewrite('bot_health',b.p+0xEC,'int',R.enabled.bot_health,b.p,true)end
        if R.enabled.bot_armour then R.savewrite('bot_armour',b.p+0xF0,'int',R.enabled.bot_armour,b.p,true)end
      end end
    end
    local focus=getForegroundProcess()==R.pid
    if R.enabled.noclip then R.flightTick(p,alive,focus)end
    if R.enabled.speed_hack and alive and focus then
      local function key(k)return isKeyPressed(k)and 1 or 0 end
      wr(p+0x74,'byte',((key(0x57)-key(0x53))*R.enabled.speed_hack)%256)
      wr(p+0x75,'byte',((key(0x41)-key(0x44))*R.enabled.speed_hack)%256);R.speed=p
    else R.releaseSpeed()end
    R.updateVisuals(p,focus,bots)
    if R.enabled.bunnyhop and alive and focus and isKeyPressed(0x20)then
      if rd(p+0x5D,'byte')~=0 then wr(p+0x5F,'byte',1);R.jump=p end
    else R.releaseJump()end
    local gun=rd(p+0xFC,'int');local firearm=gun~=0 and gun~=7
    if R.enabled.auto_refill and alive and firearm then
      local ammo=rd(p+0x104+gun*4,'int')
      if ammo&gt;0 and rd(p+0x128+gun*4,'int')&lt;=0 then
        local amount=math.min(ammo,rd(R.base+0x16BCC0+gun*104+0x56,'short'))
        wr(p+0x128+gun*4,'int',amount);wr(p+0x104+gun*4,'int',ammo-amount);wr(p+0x14C+gun*4,'int',0);wr(R.weapon(p,gun)+0x20,'int',0)
      end
    end
    if not alive or not focus or not firearm or rd(p+0x310,'int')~=0 then R.releaseAttack();return end
    local fire=R.enabled.automatic and isKeyPressed(1)
    local engaged=R.options.activation=='always'or isKeyPressed(R.options.activation=='right_mouse'and 2 or 0x12)
    if engaged then
      if R.enabled.auto_shoot then fire=true end
      if R.enabled.auto_aim or R.enabled.headshot or R.enabled.triggerbot then
        local yaw,pitch=rd(p+0x34,'float'),rd(p+0x38,'float')
        local t=R.target(R.bots(true),vec(p,4),yaw,pitch,rd(p+0x30C,'int'),R.enabled.headshot)
        R.locked=t and t.p or nil
        if t and (R.enabled.auto_aim or R.enabled.headshot)then
          yaw=(yaw+delta(t.yaw,yaw)/R.options.smoothing)%360;pitch=math.max(-89,math.min(89,pitch+(t.pitch-pitch)/R.options.smoothing))
          wr(p+0x34,'float',yaw);wr(p+0x38,'float',pitch)
          if R.enabled.headshot and math.sqrt(delta(t.yaw,yaw)^2+(t.pitch-pitch)^2)&lt;=R.options.tolerance then fire=true end
        end
        if t and R.enabled.triggerbot and t.error&lt;=R.options.tolerance then fire=true end
      end
    end
    if fire and rd(p+0x128+gun*4,'int')&gt;0 then wr(p+0x204,'byte',1);R.attack=p else R.releaseAttack()end
  end
  R.timer=createTimer(nil,false);R.timer.Interval=12
  R.timer.OnTimer=function()
    local ok,err=pcall(R.tick)
    if not ok then R.timer.Enabled=false;R.paused=tostring(err);pcall(R.nativeReset);R.releaseAttack();R.releaseJump();R.releaseSpeed();R.hideVisuals();print('RangeLab paused: '..tostring(err)..'. Uncheck controls to restore before retrying.')end
  end
  function R.enable(name,value)
    local p=R.guard();assert(not R.paused,'Disable all trainer controls before retrying after an error')
    R.enforceMultiplayer()
    assert(not(R.online()and R.offline[name]),'Offline only: '..(R.offline[name]or''))
    assert(R.labels[name],'Unknown trainer control')
    local bound=R.bounds[name];if bound then assert(type(value)=='number'and value==value and value&gt;=bound[1]and value&lt;=bound[2],'Preset is outside supported bounds')end
    assert(not R.saved[name]or not next(R.saved[name]),'Restoration pending; disable this feature first')
    if name=='noclip'or name=='hover'or name=='bunnyhop'or name=='speed_hack'then
      for _,other in ipairs({'noclip','hover','bunnyhop','speed_hack'})do if other~=name then R.turnOff(other)end end
    end
    if name=='noclip'or name=='hover'then assert(rd(p+0x76,'byte')==0 and rd(p+0xEC,'int')&gt;0,'Start from a living practice player')end
    if name=='noclip'then R.entry={p=p,pos=vec(p,4),current=vec(p,4),time=getTickCount()}end
    if name=='hover'then value=rd(p+12,'float')end
    if name=='fragile_bots'then R.turnOff('bot_health')end
    if name=='bot_health'then R.turnOff('fragile_bots')end
    if name=='auto_refill'then R.turnOff('magazines');R.turnOff('reserves')end
    if name=='magazines'or name=='reserves'then R.turnOff('auto_refill')end
    if name=='auto_aim'or name=='headshot'then R.turnOff('view_lock');R.turnOff(name=='auto_aim'and'headshot'or'auto_aim')end
    if name=='view_lock'then R.turnOff('auto_aim');R.turnOff('headshot');value={rd(p+0x34,'float'),rd(p+0x38,'float')}end
    if name=='headshot'or name=='auto_shoot'or name=='triggerbot'then
      for _,other in ipairs({'headshot','auto_shoot','triggerbot'})do if other~=name then R.turnOff(other)end end
    end
    R.saved[name]={};R.enabled[name]=value
    if name=='model_wallhack'or name=='wall_shots'then
      local ok,err=pcall(R.nativeEnable,name)
      if not ok then R.enabled[name]=nil;R.saved[name]=nil;error(err)end
    end
    local ok,err=pcall(R.tick)
    if not ok then R.enabled[name]=nil;pcall(R.nativeDisable,name);if name=='noclip'then pcall(R.finishNoclip)end;pcall(R.restore,name);R.hideVisuals();error(err)end
    R.timer.Enabled=true
  end
end

-- Edit this preset, then uncheck/recheck this action to apply it.
RangeLabCE.configureVisuals({
  esp_boxes = true,
  esp_names = true,
  esp_health = true,
  esp_armour = true,
  esp_distance = true,
  enemy_color = "#FFAF70",
  ally_color = "#74E2C7",
  crosshair_color = "#74E2C7",
  crosshair_style = "plus",
  crosshair_size = 10,
  crosshair_gap = 4,
  crosshair_width = 2,
  esp_line_width = 2,
  esp_text_size = 9,
  radar_size = 180
})
